{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["packages/**/src/**/*.ts", "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.backup",
    "**/*.broken.*",
    "**/*.old",
    "**/*.save",
    "**/tests/**/*.ts"
  ]
}
